# Copy to .env and edit. server.py reads it at start.
# PIN to open the app. Leave empty for no PIN (fine on home Wi-Fi only).
APP_PIN=
PORT=8080
# Where data.json and daily backups live (default: ./data)
# DATA_DIR=/Users/you/ration-data
# Only if saving fails through Tailscale: your Tailscale address, e.g.
# ALLOWED_ORIGINS=https://mac-mini.tail1234.ts.net
